# Only these two are required for the Google Calendar sync.
# Create a service account at console.cloud.google.com, enable the Google
# Calendar API, download its JSON key, then share your calendar with
# GOOGLE_SA_EMAIL giving it "Make changes to events".
GOOGLE_SA_EMAIL=booking-bot@your-project.iam.gserviceaccount.com
GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"

# Password for the /admin dashboard.
ADMIN_PASSWORD=change-me

# Optional. Defaults to DEFAULT_CALENDAR_ID in src/lib/calendar.server.ts.
# Set this when handing the site over to the studio's own calendar.
# GOOGLE_CALENDAR_ID=studio@example.com
