# Google Calendar — service account with "Make changes to events" on the calendar.
# Create at console.cloud.google.com, then share the calendar with GOOGLE_SA_EMAIL.
GOOGLE_SA_EMAIL=booking-bot@your-project.iam.gserviceaccount.com
GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=you@gmail.com

# Password for the /admin dashboard.
ADMIN_PASSWORD=change-me
